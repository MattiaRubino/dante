# Safe LOCAL runtime example. Copy to .env.local for local development.
# .env.local is ignored by Git and is loaded explicitly by `uv run --env-file`.
# This file contains runtime configuration only: never add postgres/admin or migrator secrets here.
DANTE_ENV=local
DANTE_RELEASE_SHA=local
DANTE_BUILD_ID=local
DANTE_DEBUG=false

DANTE_DATABASE__HOST=127.0.0.1
DANTE_DATABASE__PORT=5432
DANTE_DATABASE__NAME=dante
DANTE_DATABASE__USER=dante_runtime
DANTE_DATABASE__PASSWORD=replace-with-local-runtime-secret
DANTE_DATABASE__CONNECT_TIMEOUT_SECONDS=5
DANTE_DATABASE__POOL_SIZE=5
DANTE_DATABASE__MAX_OVERFLOW=10
DANTE_DATABASE__POOL_TIMEOUT_SECONDS=30
DANTE_DATABASE__READINESS_TIMEOUT_SECONDS=2

# Access/Auth runtime.
# Generate independent 32-byte secrets as canonical unpadded Base64URL, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Key rings are JSON so retired key IDs can remain readable during rotation.
# Every cryptographic purpose MUST use distinct key material.
# The placeholders below intentionally fail validation until replaced; never commit real secrets.
DANTE_AUTH__CANONICAL_WEB_ORIGIN=https://localhost:5173
DANTE_AUTH__PASSWORD_CURRENT_PEPPER_KEY_ID=local-password-v1
DANTE_AUTH__PASSWORD_PEPPERS={"local-password-v1":"REPLACE_WITH_CANONICAL_32_BYTE_BASE64URL"}
DANTE_AUTH__CSRF_KEY=REPLACE_WITH_DIFFERENT_CANONICAL_32_BYTE_BASE64URL
DANTE_AUTH__SIGNUP_OTP_CURRENT_KEY_ID=local-signup-otp-v1
DANTE_AUTH__SIGNUP_OTP_KEYS={"local-signup-otp-v1":"REPLACE_WITH_ANOTHER_CANONICAL_32_BYTE_BASE64URL"}

# Local SMTP sink. `plain` is accepted only for DANTE_ENV=local.
DANTE_AUTH__SMTP_HOST=127.0.0.1
DANTE_AUTH__SMTP_PORT=1025
DANTE_AUTH__SMTP_SECURITY=plain
DANTE_AUTH__SMTP_FROM_ADDRESS=no-reply@dante.local
DANTE_AUTH__SMTP_TIMEOUT_SECONDS=5
DANTE_AUTH__EMAIL_QUEUE_CAPACITY=256
DANTE_AUTH__EMAIL_WORKER_COUNT=2
DANTE_AUTH__EMAIL_SHUTDOWN_DRAIN_SECONDS=10

DANTE_AUTH__SESSION_MAX_AGE_SECONDS=2592000
DANTE_AUTH__SESSION_IDLE_TIMEOUT_SECONDS=2592000
DANTE_AUTH__RECENT_AUTH_WINDOW_SECONDS=600
DANTE_AUTH__SIGNUP_LIFETIME_SECONDS=86400
DANTE_AUTH__SIGNUP_OTP_LIFETIME_SECONDS=900
DANTE_AUTH__SIGNUP_RESEND_COOLDOWN_SECONDS=60
DANTE_AUTH__RECOVERY_LIFETIME_SECONDS=1800
DANTE_AUTH__RECOVERY_RESPONSE_FLOOR_SECONDS=0.25

DANTE_AUTH__KDF_MAX_CONCURRENCY=2
DANTE_AUTH__KDF_MAX_QUEUE_DEPTH=4
DANTE_AUTH__KDF_QUEUE_TIMEOUT_SECONDS=1
DANTE_AUTH__SIGNIN_RATE_CAPACITY=10
DANTE_AUTH__SIGNIN_RATE_WINDOW_SECONDS=60
DANTE_AUTH__SIGNIN_RATE_MAX_KEYS=10000
DANTE_AUTH__SIGNUP_RATE_CAPACITY=5
DANTE_AUTH__SIGNUP_RATE_WINDOW_SECONDS=3600
DANTE_AUTH__SIGNUP_SOURCE_RATE_CAPACITY=30
DANTE_AUTH__SIGNUP_SOURCE_RATE_WINDOW_SECONDS=3600
DANTE_AUTH__RECOVERY_RATE_CAPACITY=5
DANTE_AUTH__RECOVERY_RATE_WINDOW_SECONDS=3600
DANTE_AUTH__RECOVERY_SOURCE_RATE_CAPACITY=30
DANTE_AUTH__RECOVERY_SOURCE_RATE_WINDOW_SECONDS=3600
DANTE_AUTH__REAUTH_RATE_CAPACITY=10
DANTE_AUTH__REAUTH_RATE_WINDOW_SECONDS=300
DANTE_AUTH__LIFECYCLE_RATE_MAX_KEYS=20000

# M5 provider-flow ingress guards. Durable replay/race authority remains PostgreSQL.
DANTE_AUTH__PROVIDER_BEGIN_RATE_CAPACITY=30
DANTE_AUTH__PROVIDER_BEGIN_RATE_WINDOW_SECONDS=60
DANTE_AUTH__PROVIDER_COMPLETE_RATE_CAPACITY=20
DANTE_AUTH__PROVIDER_COMPLETE_RATE_WINDOW_SECONDS=60
DANTE_AUTH__PROVIDER_ENROLLMENT_RATE_CAPACITY=10
DANTE_AUTH__PROVIDER_ENROLLMENT_RATE_WINDOW_SECONDS=300
DANTE_AUTH__PROVIDER_RATE_MAX_KEYS=20000

DANTE_AUTH__HIBP_BASE_URL=https://api.pwnedpasswords.com
DANTE_AUTH__HIBP_TIMEOUT_SECONDS=2
DANTE_AUTH__HIBP_MAX_RESPONSE_BYTES=131072
DANTE_AUTH__HIBP_MAX_CONNECTIONS=8

# M5 provider/JWK runtime. Provider authority endpoints and RS256 allowlists use frozen code defaults.
DANTE_AUTH__PROVIDER__NETWORK__CONNECT_TIMEOUT_SECONDS=2
DANTE_AUTH__PROVIDER__NETWORK__READ_TIMEOUT_SECONDS=3
DANTE_AUTH__PROVIDER__NETWORK__WRITE_TIMEOUT_SECONDS=3
DANTE_AUTH__PROVIDER__NETWORK__POOL_TIMEOUT_SECONDS=1
DANTE_AUTH__PROVIDER__NETWORK__MAX_CONNECTIONS=8
DANTE_AUTH__PROVIDER__NETWORK__MAX_KEEPALIVE_CONNECTIONS=4
DANTE_AUTH__PROVIDER__NETWORK__MAX_JWKS_RESPONSE_BYTES=262144
DANTE_AUTH__PROVIDER__NETWORK__MAX_JWK_COUNT=32
DANTE_AUTH__PROVIDER__NETWORK__DEFAULT_JWK_TTL_SECONDS=300
DANTE_AUTH__PROVIDER__NETWORK__MAX_JWK_TTL_SECONDS=86400
DANTE_AUTH__PROVIDER__NETWORK__UNKNOWN_KID_REFRESH_COOLDOWN_SECONDS=5
DANTE_AUTH__PROVIDER__NETWORK__MAX_COMPACT_TOKEN_BYTES=16384
DANTE_AUTH__PROVIDER__NETWORK__MAX_PROTECTED_HEADER_BYTES=4096

# Keep real external providers disabled until deployment secrets/identifiers are configured.
# M5-C consumes only Google authentication identity scopes; Gmail/Calendar/Drive scopes do not belong here.
DANTE_AUTH__PROVIDER__GOOGLE__ENABLED=false
# DANTE_AUTH__PROVIDER__GOOGLE__CLIENT_ID=replace-with-google-client-id

DANTE_AUTH__PROVIDER__APPLE__ENABLED=false
# DANTE_AUTH__PROVIDER__APPLE__CLIENT_ID=replace-with-apple-service-id
# DANTE_AUTH__PROVIDER__APPLE__TEAM_ID=replace-with-apple-team-id
# DANTE_AUTH__PROVIDER__APPLE__KEY_ID=replace-with-apple-key-id
# DANTE_AUTH__PROVIDER__APPLE__CLIENT_PRIVATE_KEY_PEM=load-from-secure-runtime-secret-store
# DANTE_AUTH__PROVIDER__APPLE__GRANT_ENCRYPTION_CURRENT_KEY_ID=local-apple-grant-v1
# DANTE_AUTH__PROVIDER__APPLE__GRANT_ENCRYPTION_KEYS={"local-apple-grant-v1":"REPLACE_WITH_DISTINCT_CANONICAL_32_BYTE_BASE64URL"}

# WebAuthn/passkey policy foundation. Full ceremonies are materialized in M5-F.
DANTE_AUTH__PROVIDER__WEBAUTHN__ENABLED=false
DANTE_AUTH__PROVIDER__WEBAUTHN__RP_ID=localhost
DANTE_AUTH__PROVIDER__WEBAUTHN__RP_NAME=DANTE
DANTE_AUTH__PROVIDER__WEBAUTHN__EXPECTED_ORIGINS=["https://localhost:5173"]
