# Safe LOCAL runtime example. Copy to .env.local for local development.
# .env.local is ignored by Git and is loaded explicitly by `uv run --env-file`.
# This file contains runtime configuration only: never add postgres/admin or migrator secrets here.
DANTE_ENV=local
DANTE_RELEASE_SHA=local
DANTE_BUILD_ID=local
DANTE_DEBUG=false

DANTE_DATABASE__HOST=127.0.0.1
DANTE_DATABASE__PORT=5432
DANTE_DATABASE__NAME=dante
DANTE_DATABASE__USER=dante_runtime
DANTE_DATABASE__PASSWORD=replace-with-local-runtime-secret
DANTE_DATABASE__CONNECT_TIMEOUT_SECONDS=5
DANTE_DATABASE__POOL_SIZE=5
DANTE_DATABASE__MAX_OVERFLOW=10
DANTE_DATABASE__POOL_TIMEOUT_SECONDS=30
DANTE_DATABASE__READINESS_TIMEOUT_SECONDS=2
