# Public, build-time Web observability configuration. Never place private Grafana tokens here.
VITE_DANTE_ENV=local
VITE_DANTE_RELEASE_SHA=local
VITE_DANTE_BUILD_ID=local
VITE_DANTE_OBSERVABILITY_ENABLED=false

# LOCAL Alloy Faro receiver. For Grafana Cloud Frontend Observability, copy the
# application-specific collector URL shown by the Grafana Web SDK configuration.
VITE_DANTE_FARO_COLLECTOR_URL=http://127.0.0.1:12347/collect
VITE_DANTE_FARO_SESSION_SAMPLE_RATE=0.10
VITE_DANTE_FARO_RESPECT_GPC=true
