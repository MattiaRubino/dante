{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dante.local/schemas/database-dictionary/object-v1.schema.json",
  "title": "DANTE Database Dictionary Object v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "dictionary_version",
    "object",
    "purpose",
    "classification",
    "semantic_traceability",
    "implementation",
    "structure",
    "state_history",
    "lifecycle",
    "security",
    "proof"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dictionary_version": {
      "const": 1
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type",
        "schema",
        "name",
        "ownership_class"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(table|view|routine):dante\\.[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "table",
            "view",
            "routine"
          ]
        },
        "schema": {
          "const": "dante"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "ownership_class": {
          "const": "dante_owned"
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persistence_role",
        "canonicality",
        "family"
      ],
      "properties": {
        "persistence_role": {
          "type": "string",
          "minLength": 1
        },
        "canonicality": {
          "enum": [
            "canonical",
            "contextual",
            "relation",
            "state_history",
            "control",
            "capability_surface",
            "integrity",
            "technical"
          ]
        },
        "family": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "semantic_traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_sources",
        "domain_concepts",
        "logical_families",
        "reference_families",
        "material_facets"
      ],
      "properties": {
        "authority_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "domain_concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "logical_families": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "reference_families": {
          "type": "array",
          "items": {
            "enum": [
              "NativeRef",
              "ScopedRecordRef",
              "MaterialStateRef",
              "ExternalRef"
            ]
          },
          "uniqueItems": true
        },
        "material_facets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introducing_stage",
        "alembic_revision",
        "sqlalchemy",
        "runtime_acl_stage"
      ],
      "properties": {
        "introducing_stage": {
          "type": "string",
          "pattern": "^CP6-M0[1-7]$"
        },
        "alembic_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "sqlalchemy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "module",
            "symbol"
          ],
          "properties": {
            "mode": {
              "enum": [
                "orm_row",
                "core_view",
                "none"
              ]
            },
            "module": {
              "type": [
                "string",
                "null"
              ]
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "runtime_acl_stage": {
          "const": "CP6-M07"
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "columns",
        "primary_key",
        "foreign_keys",
        "unique_constraints",
        "check_constraints",
        "indexes",
        "triggers",
        "view",
        "routine"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primary_key": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/primaryKey"
            }
          ]
        },
        "foreign_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/foreignKey"
          }
        },
        "unique_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namedColumnConstraint"
          }
        },
        "check_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkConstraint"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trigger"
          }
        },
        "view": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/view"
            }
          ]
        },
        "routine": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/routine"
            }
          ]
        }
      }
    },
    "state_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_state_behavior",
        "current_binding",
        "chronology",
        "immutability_policy"
      ],
      "properties": {
        "material_state_behavior": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "chronology": {
          "type": [
            "string",
            "null"
          ]
        },
        "immutability_policy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "redaction",
        "retirement_tombstone",
        "delete_behavior"
      ],
      "properties": {
        "retention": {
          "type": [
            "string",
            "null"
          ]
        },
        "redaction": {
          "type": [
            "string",
            "null"
          ]
        },
        "retirement_tombstone": {
          "type": [
            "string",
            "null"
          ]
        },
        "delete_behavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_role",
        "default_deny_non_owner",
        "expected_grants"
      ],
      "properties": {
        "owner_role": {
          "const": "dante_owner"
        },
        "default_deny_non_owner": {
          "const": true
        },
        "expected_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligations",
        "test_refs",
        "staged_evidence"
      ],
      "properties": {
        "obligations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "test_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "staged_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "postgres_type",
        "nullable",
        "default",
        "meaning",
        "semantic_type",
        "value_contract"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "postgres_type": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "default": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "expression"
          ],
          "properties": {
            "kind": {
              "enum": [
                "none",
                "application",
                "server"
              ]
            },
            "expression": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "semantic_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "value_contract": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "primaryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "namedColumnConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "expression_contract",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expression_contract": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns",
        "target",
        "on_delete",
        "on_update",
        "deferrable",
        "initially",
        "reference_family",
        "cardinality",
        "semantic_reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "table",
            "columns"
          ],
          "properties": {
            "schema": {
              "const": "dante"
            },
            "table": {
              "type": "string",
              "minLength": 1
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "on_delete": {
          "type": "string",
          "minLength": 1
        },
        "on_update": {
          "type": "string",
          "minLength": 1
        },
        "deferrable": {
          "type": "boolean"
        },
        "initially": {
          "enum": [
            "IMMEDIATE",
            "DEFERRED",
            "NOT DEFERRABLE"
          ]
        },
        "reference_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "cardinality": {
          "type": "string",
          "minLength": 1
        },
        "semantic_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "method",
        "unique",
        "keys",
        "predicate",
        "include",
        "source",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "unique": {
          "type": "boolean"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ]
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "source": {
          "enum": [
            "primary_key",
            "unique_constraint",
            "explicit_index"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "routine",
        "events",
        "timing",
        "constraint_trigger",
        "deferrable",
        "initially_deferred",
        "invariant_role",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "routine": {
          "type": "string",
          "pattern": "^dante\\.[a-z][a-z0-9_]*$"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "INSERT",
              "UPDATE",
              "DELETE",
              "TRUNCATE"
            ]
          }
        },
        "timing": {
          "enum": [
            "BEFORE",
            "AFTER",
            "INSTEAD OF"
          ]
        },
        "constraint_trigger": {
          "type": "boolean"
        },
        "deferrable": {
          "type": "boolean"
        },
        "initially_deferred": {
          "type": "boolean"
        },
        "invariant_role": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_relations",
        "predicate_contract",
        "check_option",
        "automatically_updatable",
        "runtime_dml_surface"
      ],
      "properties": {
        "base_relations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dante\\.[a-z][a-z0-9_]*$"
          }
        },
        "predicate_contract": {
          "type": "string",
          "minLength": 1
        },
        "check_option": {
          "enum": [
            "LOCAL",
            "CASCADED",
            "NONE"
          ]
        },
        "automatically_updatable": {
          "type": "boolean"
        },
        "runtime_dml_surface": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "routine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routine_kind",
        "language",
        "security",
        "volatility",
        "parallel_safety",
        "direct_runtime_execute"
      ],
      "properties": {
        "routine_kind": {
          "enum": [
            "function",
            "procedure"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "enum": [
            "INVOKER",
            "DEFINER"
          ]
        },
        "volatility": {
          "enum": [
            "IMMUTABLE",
            "STABLE",
            "VOLATILE"
          ]
        },
        "parallel_safety": {
          "enum": [
            "SAFE",
            "RESTRICTED",
            "UNSAFE"
          ]
        },
        "direct_runtime_execute": {
          "type": "boolean"
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grantee",
        "privilege",
        "columns",
        "grant_option"
      ],
      "properties": {
        "grantee": {
          "type": "string",
          "minLength": 1
        },
        "privilege": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "grant_option": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "object": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "structure": {
            "properties": {
              "view": {
                "type": "null"
              },
              "routine": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object": {
            "properties": {
              "type": {
                "const": "view"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "structure": {
            "properties": {
              "view": {
                "$ref": "#/$defs/view"
              },
              "routine": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object": {
            "properties": {
              "type": {
                "const": "routine"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "structure": {
            "properties": {
              "view": {
                "type": "null"
              },
              "routine": {
                "$ref": "#/$defs/routine"
              }
            }
          }
        }
      }
    }
  ]
}
