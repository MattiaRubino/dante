# Non-secret LOCAL routing. Copy to .env.local; never place API keys here.
DANTE_ENV=local
DANTE_BACKEND_HEALTH_URL=http://host.docker.internal:8000/health/ready
DANTE_FARO_ORIGIN_PRIMARY=https://localhost:5173
DANTE_FARO_ORIGIN_SECONDARY=https://127.0.0.1:4173

# Copy the exact Grafana Cloud connection values for your EU stack.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp
GRAFANA_CLOUD_OTLP_USERNAME=REPLACE_WITH_OTLP_INSTANCE_ID
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-eu-west-0.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=REPLACE_WITH_PROMETHEUS_INSTANCE_ID
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-eu-west-0.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USERNAME=REPLACE_WITH_LOKI_INSTANCE_ID
