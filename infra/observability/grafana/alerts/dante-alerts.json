{
  "schema_version": 2,
  "description": "Source-controlled DANTE Grafana alert contract. Every rule separates a numeric PromQL signal from its explicit evaluator so healthy false conditions never collapse into ambiguous NoData.",
  "rules": [
    {
      "id": "dante-backend-unavailable",
      "title": "DANTE backend is unavailable",
      "severity": "critical",
      "expr": "min_over_time(probe_success{job=\"integrations/blackbox/dante-backend-ready\",environment=\"prod\"}[2m])",
      "lookback_seconds": 180,
      "evaluator": {"type": "lt", "threshold": 1},
      "for": "2m",
      "no_data_state": "alerting",
      "description": "The external readiness probe has failed continuously.",
      "runbook_anchor": "backend-unavailable"
    },
    {
      "id": "dante-backend-error-ratio",
      "title": "DANTE backend 5xx ratio is elevated",
      "severity": "critical",
      "expr": "(sum(rate(http_server_request_count_total{deployment_environment_name=\"prod\",dante_outcome=\"server_error\"}[5m])) / clamp_min(sum(rate(http_server_request_count_total{deployment_environment_name=\"prod\"}[5m])), 0.001)) and on() (sum(rate(http_server_request_count_total{deployment_environment_name=\"prod\"}[5m])) > 0.1)",
      "lookback_seconds": 360,
      "evaluator": {"type": "gt", "threshold": 0.1},
      "for": "5m",
      "no_data_state": "ok",
      "description": "More than ten percent of active backend traffic is returning server errors.",
      "runbook_anchor": "backend-error-ratio"
    },
    {
      "id": "dante-backend-latency",
      "title": "DANTE backend latency p95 is elevated",
      "severity": "warning",
      "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{deployment_environment_name=\"prod\"}[5m])))",
      "lookback_seconds": 360,
      "evaluator": {"type": "gt", "threshold": 1},
      "for": "10m",
      "no_data_state": "ok",
      "description": "Backend p95 latency has exceeded one second under observed traffic.",
      "runbook_anchor": "backend-latency"
    },
    {
      "id": "dante-database-readiness",
      "title": "DANTE database readiness is failing",
      "severity": "critical",
      "expr": "sum(increase(dante_database_readiness_checks_total{deployment_environment_name=\"prod\",dante_outcome=\"error\"}[5m]))",
      "lookback_seconds": 360,
      "evaluator": {"type": "gt", "threshold": 0},
      "for": "2m",
      "no_data_state": "ok",
      "description": "The backend could not complete its bounded PostgreSQL readiness check.",
      "runbook_anchor": "database-readiness"
    },
    {
      "id": "dante-auth-kdf-saturation",
      "title": "DANTE password KDF admission is saturated",
      "severity": "warning",
      "expr": "sum(increase(dante_auth_kdf_rejections_total{deployment_environment_name=\"prod\"}[5m]))",
      "lookback_seconds": 360,
      "evaluator": {"type": "gt", "threshold": 0},
      "for": "5m",
      "no_data_state": "ok",
      "description": "Password verification work is being rejected or timing out at the bounded admission gate.",
      "runbook_anchor": "auth-kdf-saturation"
    },
    {
      "id": "dante-alloy-missing",
      "title": "DANTE Alloy collector is missing",
      "severity": "critical",
      "expr": "max_over_time(up{job=\"integrations/self\",environment=\"prod\"}[5m])",
      "lookback_seconds": 360,
      "evaluator": {"type": "lt", "threshold": 1},
      "for": "2m",
      "no_data_state": "alerting",
      "description": "The collector has stopped reporting its own scrape signal.",
      "runbook_anchor": "alloy-missing"
    },
    {
      "id": "dante-log-delivery-drops",
      "title": "DANTE log delivery is dropping entries",
      "severity": "warning",
      "expr": "sum(increase(loki_write_dropped_entries_total{environment=\"prod\"}[10m]))",
      "lookback_seconds": 660,
      "evaluator": {"type": "gt", "threshold": 0},
      "for": "5m",
      "no_data_state": "ok",
      "description": "Alloy exhausted bounded Loki delivery retries and discarded telemetry.",
      "runbook_anchor": "telemetry-delivery"
    },
    {
      "id": "dante-metrics-delivery-failures",
      "title": "DANTE metrics delivery is failing",
      "severity": "warning",
      "expr": "sum(increase(prometheus_remote_storage_samples_failed_total{environment=\"prod\"}[10m]))",
      "lookback_seconds": 660,
      "evaluator": {"type": "gt", "threshold": 0},
      "for": "5m",
      "no_data_state": "ok",
      "description": "Prometheus remote write is recording failed samples after its bounded policy.",
      "runbook_anchor": "telemetry-delivery"
    }
  ]
}
