{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Grafana Cloud Logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Grafana Cloud Traces",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Black-box readiness from outside the backend process.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 1, "text": "DOWN"},
                "1": {"color": "green", "index": 0, "text": "READY"}
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "12.1.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "min(probe_success{job=\"integrations/blackbox/dante-backend-ready\",environment=~\"$environment\"})",
          "legendFormat": "readiness",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Backend readiness",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Completed requests per second from route-template-only RED telemetry.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 10, "x": 4, "y": 0},
      "id": 2,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (http_route, http_request_method) (rate(http_server_request_count_total{deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request rate by route",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Share of completed backend requests returning 5xx.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.02},
              {"color": "red", "value": 0.1}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 5, "x": 14, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(http_server_request_count_total{deployment_environment_name=~\"$environment\",dante_outcome=\"server_error\"}[5m])) / clamp_min(sum(rate(http_server_request_count_total{deployment_environment_name=~\"$environment\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Backend 5xx ratio",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "95th percentile across bounded route-template labels.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 5, "x": 19, "y": 0},
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{deployment_environment_name=~\"$environment\"}[5m])))",
          "legendFormat": "p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Backend latency p95",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Server-authoritative signin outcomes; no account or email label is exported.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "custom": {"drawStyle": "bars", "fillOpacity": 55, "lineWidth": 1, "stacking": {"group": "A", "mode": "normal"}}, "unit": "ops"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (dante_auth_outcome) (increase(dante_auth_signin_attempts_total{deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dante_auth_outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Signin outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Rejected or timed-out password KDF admissions; sustained values indicate saturation.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "ops"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "id": 6,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (dante_queue_state) (increase(dante_auth_kdf_rejections_total{deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{dante_queue_state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "KDF admission rejections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "External Auth dependency pressure, bounded to dependency and outcome.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "id": 7,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (server_address, dante_outcome) (rate(dante_auth_dependency_requests_total{deployment_environment_name=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{server_address}} · {{dante_outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Auth dependency outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "PostgreSQL client latency without SQL text or bind parameters.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "s"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 16},
      "id": 8,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, db_operation_name) (rate(db_client_operation_duration_seconds_bucket{deployment_environment_name=~\"$environment\"}[5m])))",
          "legendFormat": "{{db_operation_name}} p95",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Database operation latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "SQLAlchemy pool state from application-side instrumentation.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 8, "y": 16},
      "id": 9,
      "options": {
        "legend": {"calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (state) (db_client_connections_usage{deployment_environment_name=~\"$environment\"})",
          "legendFormat": "{{state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Application DB pool",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Database connections observed through the dedicated statistics-only role.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short"},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 16},
      "id": 10,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (datname) (pg_stat_database_numbackends{job=\"integrations/postgres\",environment=~\"$environment\"})",
          "legendFormat": "{{datname}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "PostgreSQL connections",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "description": "Redacted structured error events. Expand a row to use request_id or trace_id for correlation.",
      "gridPos": {"h": 10, "w": 16, "x": 0, "y": 24},
      "id": 11,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{application=\"dante\",environment=~\"$environment\"} | json | severity=~\"error|warning\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent operational errors",
      "type": "logs"
    },
    {
      "datasource": {"type": "tempo", "uid": "${DS_TEMPO}"},
      "description": "Sampled backend error traces, correlated with structured logs by trace_id.",
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 10, "w": 8, "x": 16, "y": 24},
      "id": 12,
      "options": {"cellHeight": "sm", "showHeader": true},
      "targets": [
        {
          "limit": 50,
          "query": "{ resource.service.name = \"dante-backend\" && status = error }",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent backend error traces",
      "type": "table"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["dante", "observability", "service"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "local", "value": "local"},
        "hide": 0,
        "includeAll": false,
        "label": "Environment",
        "multi": false,
        "name": "environment",
        "options": [
          {"selected": true, "text": "local", "value": "local"},
          {"selected": false, "text": "dev", "value": "dev"},
          {"selected": false, "text": "uat", "value": "uat"},
          {"selected": false, "text": "prod", "value": "prod"}
        ],
        "query": "local,dev,uat,prod",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "DANTE · Service overview",
  "uid": "dante-service-overview",
  "version": 1,
  "weekStart": "monday"
}
