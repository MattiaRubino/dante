{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Grafana Cloud Metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Grafana Cloud Logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Collector self-scrape. No data is a failure for this panel.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "index": 1, "text": "DOWN"}, "1": {"color": "green", "index": 0, "text": "UP"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {"editorMode": "code", "expr": "min(up{job=\"integrations/self\",environment=~\"$environment\"})", "legendFormat": "Alloy", "range": true, "refId": "A"}
      ],
      "title": "Alloy",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Resident collector memory against the 512 MiB container ceiling.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 536870912,
          "min": 0,
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 335544320}, {"color": "red", "value": 436207616}]},
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 5, "w": 5, "x": 4, "y": 0},
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {"editorMode": "code", "expr": "max(process_resident_memory_bytes{job=\"integrations/self\",environment=~\"$environment\"})", "legendFormat": "RSS", "range": true, "refId": "A"}
      ],
      "title": "Collector memory",
      "type": "gauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "OpenTelemetry exporter failures. Queues and retries are finite; any sustained increase needs investigation.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 9, "y": 0},
      "id": 3,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum by (exporter) (increase(otelcol_exporter_send_failed_spans_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "spans · {{exporter}}", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum by (exporter) (increase(otelcol_exporter_send_failed_metric_points_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "metric points · {{exporter}}", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum by (exporter) (increase(otelcol_exporter_send_failed_log_records_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "log records · {{exporter}}", "range": true, "refId": "C"}
      ],
      "title": "OTLP export failures",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Items waiting in bounded OpenTelemetry exporter queues.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 7, "x": 17, "y": 0},
      "id": 4,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "max by (exporter) (otelcol_exporter_queue_size{environment=~\"$environment\"})", "legendFormat": "{{exporter}}", "range": true, "refId": "A"}
      ],
      "title": "OTLP queue depth",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Loki write retries and final drops from backend/Faro streams.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 5,
      "options": {
        "legend": {"calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(increase(loki_write_batch_retries_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "retries", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(increase(loki_write_dropped_entries_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "dropped entries", "range": true, "refId": "B"}
      ],
      "title": "Log delivery",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Remote-write backlog and failures. The WAL is retained for at most one hour.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 6,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(prometheus_remote_storage_samples_pending{environment=~\"$environment\"})", "legendFormat": "pending", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(increase(prometheus_remote_storage_samples_failed_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "failed", "range": true, "refId": "B"},
        {"editorMode": "code", "expr": "sum(increase(prometheus_remote_storage_samples_retries_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "retried", "range": true, "refId": "C"}
      ],
      "title": "Metrics remote write",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Browser collector intake, rejection and exporter errors. LOCAL/UAT only when using Alloy's Faro receiver.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 7,
      "options": {
        "legend": {"calcs": ["lastNotNull", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(faro_receiver_requests_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "accepted", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(rate(faro_receiver_exporter_errors_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "export errors", "range": true, "refId": "B"}
      ],
      "title": "Faro intake",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Samples generated by each controlled scrape before remote write; use this to protect the Free-plan budget.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 8,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum by (job) (scrape_samples_post_metric_relabeling{environment=~\"$environment\"})", "legendFormat": "{{job}}", "range": true, "refId": "A"}
      ],
      "title": "Scraped series by job",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Outbound Loki volume. A sudden increase is both a product signal and an ingestion-budget risk.",
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}, "unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 9,
      "options": {
        "legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true},
        "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(loki_write_sent_bytes_total{environment=~\"$environment\"}[$__rate_interval]))", "legendFormat": "sent bytes/s", "range": true, "refId": "A"}
      ],
      "title": "Log ingestion rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "${DS_LOKI}"},
      "description": "Redacted backend warnings/errors; collector delivery failures remain in the self-metric panels above.",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
      "id": 10,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {"direction": "backward", "editorMode": "code", "expr": "{application=\"dante\",environment=~\"$environment\"} | json | severity=~\"error|warning\" | service_name=\"dante-backend\"", "queryType": "range", "refId": "A"}
      ],
      "title": "Backend telemetry warnings",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["dante", "observability", "collector", "budget"],
  "templating": {
    "list": [
      {
        "current": {"selected": true, "text": "local", "value": "local"},
        "hide": 0,
        "includeAll": false,
        "label": "Environment",
        "multi": false,
        "name": "environment",
        "options": [
          {"selected": true, "text": "local", "value": "local"},
          {"selected": false, "text": "dev", "value": "dev"},
          {"selected": false, "text": "uat", "value": "uat"},
          {"selected": false, "text": "prod", "value": "prod"}
        ],
        "query": "local,dev,uat,prod",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "DANTE · Telemetry pipeline & budget",
  "uid": "dante-telemetry-pipeline",
  "version": 1,
  "weekStart": "monday"
}
