{
  "name": "dante",
  "private": true,
  "scripts": {
    "architecture:check": "dependency-cruise --config dependency-cruiser.config.mjs -- apps/web/src apps/mobile/app apps/mobile/src packages/design-tokens packages/i18n packages/time",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generated:check": "node tooling/check-generated.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "test:e2e:web": "pnpm --filter @dante/web test:e2e",
    "mobile:compat:check": "pnpm --filter @dante/mobile exec expo install --check",
    "mobile:bundle:check": "node tooling/check-mobile-bundle.mjs"
  },
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.22.0"
  },
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.8.1",
    "prettier": "3.9.0",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
