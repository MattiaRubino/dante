{
  "components": {
    "schemas": {
      "AuthenticatedSessionResponse": {
        "additionalProperties": false,
        "description": "Authenticated bootstrap/session representation.",
        "properties": {
          "account_ref": {
            "format": "uuid",
            "title": "Account Ref",
            "type": "string"
          },
          "auth_session_ref": {
            "format": "uuid",
            "title": "Auth Session Ref",
            "type": "string"
          },
          "authenticated": {
            "const": true,
            "title": "Authenticated",
            "type": "boolean"
          },
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "recent_auth_at": {
            "format": "date-time",
            "title": "Recent Auth At",
            "type": "string"
          }
        },
        "required": [
          "account_ref",
          "auth_session_ref",
          "authenticated",
          "csrf_token",
          "expires_at",
          "recent_auth_at"
        ],
        "title": "AuthenticatedSessionResponse",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "DANTE RFC 9457 public error contract.",
        "properties": {
          "category": {
            "title": "Category",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ProblemFieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "category",
          "request_id",
          "retryable"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ProblemFieldError": {
        "additionalProperties": false,
        "description": "Stable bounded field error surfaced to first-party clients.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          },
          "parameters": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parameters"
          },
          "pointer": {
            "title": "Pointer",
            "type": "string"
          }
        },
        "required": ["pointer", "code", "detail"],
        "title": "ProblemFieldError",
        "type": "object"
      },
      "SignInRequest": {
        "additionalProperties": false,
        "description": "Bounded first-party email/password signin request.",
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 1,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "title": "SignInRequest",
        "type": "object"
      },
      "UnauthenticatedSessionResponse": {
        "additionalProperties": false,
        "description": "Unauthenticated bootstrap representation.",
        "properties": {
          "authenticated": {
            "const": false,
            "title": "Authenticated",
            "type": "boolean"
          }
        },
        "required": ["authenticated"],
        "title": "UnauthenticatedSessionResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "DanteSessionCookie": {
        "description": "Opaque host-only HttpOnly Secure AuthSession bearer cookie; browser transport owns it.",
        "in": "cookie",
        "name": "__Host-dante-session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "DANTE Backend",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/session": {
      "delete": {
        "description": "Idempotently revoke the current valid AuthSession and clear its cookie.",
        "operationId": "auth_log_out",
        "responses": {
          "204": {
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "Clears the current __Host-dante-session cookie.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "DanteSessionCookie": []
          }
        ],
        "summary": "Log Out",
        "tags": ["auth"],
        "x-dante-browser-security": {
          "client_header": {
            "name": "X-Dante-Client",
            "owner": "web_transport",
            "required": true,
            "required_value": "web"
          },
          "csrf_header": {
            "name": "X-Dante-CSRF",
            "owner": "web_transport",
            "required_when": "valid_auth_session_admitted"
          },
          "origin": {
            "must_equal": "canonical_web_origin",
            "owner": "browser",
            "required": true
          },
          "sec_fetch_site": {
            "owner": "browser",
            "required": true,
            "required_value": "same-origin"
          }
        }
      },
      "get": {
        "description": "Return authoritative current Web session state without user activity.",
        "operationId": "auth_get_session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AuthenticatedSessionResponse"
                    },
                    {
                      "$ref": "#/components/schemas/UnauthenticatedSessionResponse"
                    }
                  ],
                  "title": "Response Auth Get Session"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "May clear an invalid or expired __Host-dante-session cookie.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {},
          {
            "DanteSessionCookie": []
          }
        ],
        "summary": "Get Session",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/signin": {
      "post": {
        "description": "Authenticate email/password and establish one new independent AuthSession.",
        "operationId": "auth_sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticatedSessionResponse"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "May establish the host-only HttpOnly Secure __Host-dante-session cookie.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unprocessable Content",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Too Many Requests",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Minimum delay before another signin attempt is useful.",
                "schema": {
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal Server Error",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable",
            "headers": {
              "Cache-Control": {
                "description": "Auth responses are never cacheable by shared or browser caches.",
                "schema": {
                  "const": "no-store",
                  "type": "string"
                }
              },
              "X-Request-ID": {
                "description": "Server-authoritative non-secret request correlation identifier.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Sign In",
        "tags": ["auth"],
        "x-dante-browser-security": {
          "client_header": {
            "name": "X-Dante-Client",
            "owner": "web_transport",
            "required": true,
            "required_value": "web"
          },
          "origin": {
            "must_equal": "canonical_web_origin",
            "owner": "browser",
            "required": true
          },
          "sec_fetch_site": {
            "owner": "browser",
            "required": true,
            "required_value": "same-origin"
          }
        }
      }
    }
  }
}
