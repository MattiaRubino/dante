{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "semantic": {
    "color": {
      "$type": "color",
      "brand": {
        "ink": {
          "$value": "{primitive.color.brand-ink}"
        },
        "accent": {
          "$value": "{primitive.color.brand-accent}"
        },
        "accent-text": {
          "$value": "{primitive.color.brand-accent-text}"
        }
      },
      "surface": {
        "base": {
          "$value": "{primitive.color.white}"
        },
        "soft": {
          "$value": "{primitive.color.warm-50}"
        },
        "muted": {
          "$value": "{primitive.color.warm-100}"
        }
      },
      "text": {
        "primary": {
          "$value": "{primitive.color.brand-ink}"
        },
        "secondary": {
          "$value": "{primitive.color.text-secondary}"
        },
        "muted": {
          "$value": "{primitive.color.text-muted}"
        }
      },
      "border": {
        "control": {
          "$value": "{primitive.color.border-control}"
        },
        "hover": {
          "$value": "{primitive.color.border-hover}"
        },
        "divider": {
          "$value": "{primitive.color.divider}"
        }
      },
      "focus": {
        "ring": {
          "$value": "{primitive.color.brand-accent}"
        }
      },
      "home": {
        "canvas": {
          "$value": "{primitive.color.home-canvas}"
        },
        "surface": {
          "primary": {
            "$value": "{primitive.color.home-surface-primary}"
          },
          "raised": {
            "$value": "{primitive.color.home-surface-raised}"
          },
          "control": {
            "$value": "{primitive.color.home-surface-control}"
          }
        },
        "text": {
          "primary": {
            "$value": "{primitive.color.home-text-primary}"
          },
          "secondary": {
            "$value": "{primitive.color.home-text-secondary}"
          },
          "muted": {
            "$value": "{primitive.color.home-text-muted}"
          }
        },
        "border": {
          "subtle": {
            "$value": "{primitive.color.home-border-subtle}"
          },
          "strong": {
            "$value": "{primitive.color.home-border-strong}"
          }
        },
        "chrome": {
          "active": {
            "$value": "{primitive.color.brand-accent}"
          },
          "active-text": {
            "$value": "{primitive.color.home-accent-text}"
          },
          "active-soft": {
            "$value": "{primitive.color.home-accent-soft}"
          },
          "active-border": {
            "$value": "{primitive.color.home-accent-border}"
          },
          "inactive": {
            "$value": "{primitive.color.home-chrome-neutral}"
          },
          "inactive-border": {
            "$value": "{primitive.color.home-chrome-neutral-border}"
          }
        }
      }
    },
    "radius": {
      "$type": "dimension",
      "card": {
        "$value": "{primitive.radius.20}"
      },
      "panel": {
        "$value": "{primitive.radius.12}"
      },
      "control": {
        "$value": "{primitive.radius.14}"
      },
      "input": {
        "$value": "{primitive.radius.12}"
      }
    }
  }
}
